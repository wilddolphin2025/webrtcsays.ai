diff --git a/examples/direct/signaling_bind.h b/examples/direct/signaling_bind.h
new file mode 100644
index 0000000000..5d5a33d537
--- /dev/null
+++ b/examples/direct/signaling_bind.h
@@ -0,0 +1,54 @@
+/*
+ * Signaling listen address. Empty means the historical INADDR_ANY bind.
+ * This chooses the TCP signaling socket and the WebSocket signaling socket
+ * only. It is not an ICE or media setting.
+ */
+#ifndef EXAMPLES_DIRECT_SIGNALING_BIND_H_
+#define EXAMPLES_DIRECT_SIGNALING_BIND_H_
+
+#include <arpa/inet.h>
+#include <netinet/in.h>
+
+#include <string>
+
+// On success writes the IPv4 address to bind, in network byte order.
+// An empty value and "0.0.0.0" both mean INADDR_ANY, which is the behavior
+// of binaries that do not know this setting. Any other value must be a
+// dotted IPv4 address. Hostnames are rejected so a typo cannot resolve onto
+// a public interface. On failure *addr is left unchanged.
+inline bool ResolveSignalingBind(const std::string& signaling_bind,
+                                 in_addr_t* addr,
+                                 std::string* error) {
+  if (error) {
+    error->clear();
+  }
+  if (!addr) {
+    if (error) {
+      *error = "missing address";
+    }
+    return false;
+  }
+  if (signaling_bind.empty() || signaling_bind == "0.0.0.0") {
+    *addr = htonl(INADDR_ANY);
+    return true;
+  }
+  for (unsigned char ch : signaling_bind) {
+    if (ch <= ' ' || ch >= 127) {
+      if (error) {
+        *error = "signaling_bind must be a dotted IPv4 address";
+      }
+      return false;
+    }
+  }
+  struct in_addr parsed = {};
+  if (inet_pton(AF_INET, signaling_bind.c_str(), &parsed) != 1) {
+    if (error) {
+      *error = "signaling_bind must be a dotted IPv4 address";
+    }
+    return false;
+  }
+  *addr = parsed.s_addr;
+  return true;
+}
+
+#endif  // EXAMPLES_DIRECT_SIGNALING_BIND_H_
diff --git a/examples/direct/signaling_bind_test.cc b/examples/direct/signaling_bind_test.cc
new file mode 100644
index 0000000000..5d952a113e
--- /dev/null
+++ b/examples/direct/signaling_bind_test.cc
@@ -0,0 +1,78 @@
+// Standalone check for the signaling listen address. It does not link WebRTC.
+#include "signaling_bind.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+int failures = 0;
+
+void Expect(bool cond, const char* name) {
+  if (!cond) {
+    std::fprintf(stderr, "FAIL %s\n", name);
+    ++failures;
+  }
+}
+
+in_addr_t Parse(const char* text) {
+  struct in_addr parsed = {};
+  if (inet_pton(AF_INET, text, &parsed) != 1) {
+    std::fprintf(stderr, "bad fixture %s\n", text);
+    std::exit(2);
+  }
+  return parsed.s_addr;
+}
+
+}  // namespace
+
+int main() {
+  in_addr_t addr = 0x11111111;
+  std::string error = "stale";
+  Expect(ResolveSignalingBind("", &addr, &error), "empty ok");
+  Expect(addr == htonl(INADDR_ANY), "empty is any");
+  Expect(error.empty(), "empty clears error");
+
+  addr = 0x22222222;
+  error = "stale";
+  Expect(ResolveSignalingBind("0.0.0.0", &addr, &error), "any literal ok");
+  Expect(addr == htonl(INADDR_ANY), "any literal");
+
+  addr = 0x33333333;
+  Expect(ResolveSignalingBind("127.0.0.1", &addr, &error), "loopback ok");
+  Expect(addr == Parse("127.0.0.1"), "loopback value");
+  Expect(addr != htonl(INADDR_ANY), "loopback is not any");
+
+  const in_addr_t sentinel = 0x44444444;
+  addr = sentinel;
+  Expect(!ResolveSignalingBind("localhost", &addr, &error), "reject hostname");
+  Expect(addr == sentinel, "hostname leaves addr");
+  Expect(!error.empty(), "hostname explains");
+
+  addr = sentinel;
+  Expect(!ResolveSignalingBind("turn.wilddolphin.us", &addr, &error),
+         "reject dns");
+  Expect(addr == sentinel, "dns leaves addr");
+
+  addr = sentinel;
+  Expect(!ResolveSignalingBind("::1", &addr, &error), "reject ipv6");
+  Expect(addr == sentinel, "ipv6 leaves addr");
+
+  addr = sentinel;
+  Expect(!ResolveSignalingBind("127.0.0.1 ", &addr, &error), "reject space");
+  Expect(addr == sentinel, "space leaves addr");
+
+  addr = sentinel;
+  Expect(ResolveSignalingBind("10.1.2.3", &addr, &error), "unicast ok");
+  Expect(addr == Parse("10.1.2.3"), "unicast value");
+
+  Expect(!ResolveSignalingBind("127.0.0.1", nullptr, &error), "null out");
+
+  if (failures) {
+    std::fprintf(stderr, "%d failure(s)\n", failures);
+    return 1;
+  }
+  std::printf("signaling_bind ok\n");
+  return 0;
+}
