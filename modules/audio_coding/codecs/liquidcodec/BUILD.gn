# LiquidCodec is macOS-only. Linux and the arm64 Frame build do not compile
# this target. rtc_use_liquidcodec defaults off in webrtc.gni.
#
# Labels are absolute. A relative ../../../ from this directory is //modules,
# so import("../../../webrtc.gni") and deps like "../../../api" do not exist.

import("//webrtc.gni")

if (is_mac && rtc_use_liquidcodec) {
rtc_library("liquidcodec") {
  testonly = true
  visibility = [ "//examples:*" ]
  defines = [ "WEBRTC_USE_LIQUIDCODEC" ]
  sources = [
    "audio_decoder_liquid.cc",
    "audio_decoder_liquid.h",
    "audio_encoder_liquid.cc",
    "audio_encoder_liquid.h",
    "liquid_codec.cc",
    "liquid_codec.h",
    "liquid_coreml.mm",
    "liquid_factory.cc",
    "liquid_factory.h",
    "liquid_stream.cc",
    "liquid_stream.h",
    "liquid_tail.cc",
    "liquid_tail.h",
    "liquid_backend.h",
  ]
  deps = [
    "//api:make_ref_counted",
    "//api:scoped_refptr",
    "//api/audio_codecs:audio_codecs_api",
    "//api/environment",
    "//api/units:time_delta",
    "//common_audio",
    "//rtc_base:buffer",
    "//rtc_base:checks",
    "//rtc_base:logging",
    "//third_party/abseil-cpp/absl/strings",
  ]
  frameworks = [
    "CoreML.framework",
    "Foundation.framework",
  ]
}
}
