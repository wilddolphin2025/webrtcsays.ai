# LiquidCall Core ML is macOS and iOS. rtc_use_liquidcall defaults off.
# The Android path is liquid_onnx.cc (ONNX Runtime CPU), compiled by the
# CetaCall Android CMake with WEBRTC_LIQUID_ONNX. It is not a gn source:
# this tree does not fetch ONNX Runtime. liquid_backend_select.cc picks
# Core ML here and ONNX when that flag is set.
#
# Labels are absolute. A relative ../../../ from this directory is //modules,
# so import("../../../webrtc.gni") and deps like "../../../api" do not exist.

import("//webrtc.gni")

if ((is_mac || is_ios) && rtc_use_liquidcall) {
rtc_library("liquidcall") {
  testonly = true
  visibility = [ "//examples:*" ]
  defines = [ "WEBRTC_USE_LIQUIDCALL" ]
  sources = [
    "audio_decoder_liquid.cc",
    "audio_decoder_liquid.h",
    "audio_encoder_liquid.cc",
    "audio_encoder_liquid.h",
    "liquid_codec.cc",
    "liquid_codec.h",
    "liquid_coreml.mm",
    "liquid_factory.cc",
    "liquid_factory.h",
    "liquid_stream.cc",
    "liquid_stream.h",
    "liquid_tail.cc",
    "liquid_tail.h",
    "liquid_backend.h",
    "liquid_backend_select.cc",
  ]
  deps = [
    "//api:make_ref_counted",
    "//api:scoped_refptr",
    "//api/audio_codecs:audio_codecs_api",
    "//api/environment",
    "//api/units:time_delta",
    "//common_audio",
    "//rtc_base:buffer",
    "//rtc_base:checks",
    "//rtc_base:logging",
    "//third_party/abseil-cpp/absl/strings",
  ]
  frameworks = [
    "CoreML.framework",
    "Foundation.framework",
  ]
}
}
